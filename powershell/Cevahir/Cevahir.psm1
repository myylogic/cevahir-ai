        # A checkpoint file (registered or not).
        [Parameter(ValueFromPipelineByPropertyName)][Alias('FullName')][string]$Path,
        # File: bytes and envelope safety, no torch. Weights: also read the tensors. Compat: also compare with the layout the current code builds and with -Target.
        [Parameter()][ValidateSet('File', 'Weights', 'Compat')][string]$Level,
        # What the checkpoint is to be used for; it decides which checks are required.
