function Export-CvArtifact {
    <#
    .SYNOPSIS
    Writes artefacts to a .cvb bundle for another machine.
    .EXAMPLE
    Get-CvCheckpoint -Best | Export-CvArtifact -To D:\transfer\best.cvb -IncludePayload
    #>
    [CmdletBinding()]
    [OutputType('Cevahir.Bundle')]
    param(
        # Artefacts to export (or pipe them in).
        [Parameter(Position = 0)][Alias('Id')][string[]]$Key,
        # The .cvb file to write.
        [Parameter(Mandatory)][string]$To,
        # Also pack the payload files (the checkpoint itself).
        [Parameter()][switch]$IncludePayload,
        # Also pack this machine's audit chain. It holds every recorded action, with local paths.
        [Parameter()][switch]$IncludeAudit,
        # Show what would happen; change nothing.
        [Parameter()][switch]$WhatIf
    )
    begin { $collected = @() }
    process {
        if ($_ -and $_.PSObject.Properties['Key']) { $collected += [string]$_.Key }
    }
    end {
        $bound = ConvertTo-CvParameters $PSBoundParameters
        if ($collected.Count) { $bound['Key'] = @(@($bound['Key']) + $collected | Where-Object { $_ }) }
        Invoke-CvHost -Command 'Export-Artifact' -Parameters $bound
    }
}

