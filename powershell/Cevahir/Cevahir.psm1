        # Target legacy tokenizer: merges.txt.
        [Parameter()][string]$Merges,
        # Target byte-level BPE tokenizer file.
        [Parameter()][string]$ByteBpe,
        # Target floating dtype.
        [Parameter()][string]$Dtype,
        # Serving context length.
        [Parameter()][int]$MaxSeqLength,
        # Ids of migrations that may be applied in memory.
        [Parameter()][string[]]$AllowMigration,
        # Do not append the verdict to the audit log.
        [Parameter()][switch]$NoRecord
