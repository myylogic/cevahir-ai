+    # ---- kept readings (``onbellek``): which of the store's adjacency lists changed, and when
+    # A reading notes the lists it looked up: the ties out of a unit of one form and lag, or into a unit of one form
+    # (``key_out`` / ``key_in``, one packed integer each). A noted list gets a place in ``_kst`` (its "stamp": the
+    # store's version when a tie of the list was last made or its evidence last changed). Only noted lists are
+    # stamped, only units that have a noted list are looked at when something is written (``_uw``), and nothing of
+    # this is saved or copied.
+    @staticmethod
+    def key_out(unit: int, form: int, lag: int) -> int:
+        return (((unit << 6) | form) << 6 | ((-1 if form == PART else lag) + 2)) << 1
+
+    @staticmethod
+    def key_in(unit: int, form: int) -> int:
+        return (((unit << 6) | form) << 1) | 1
+
+    def key_id(self, key: int) -> int:
+        """The place of a noted list's stamp (given one, stamped now, when it is noted for the first time: it may
+        have changed at any moment before)."""
+        kid = self.__dict__.get("_kid")
+        if kid is None:
+            kid = self.__dict__["_kid"] = {}
+            self.__dict__["_kst"] = np.zeros(4096, dtype=np.int64)
+            self.__dict__["_uw"] = np.zeros(self._cu, dtype=bool)
+        i = kid.get(key)
+        if i is None:
+            i = kid[key] = len(kid)
+            if i == self._kst.shape[0]:
+                grown = np.zeros(2 * i, dtype=np.int64)
+                grown[:i] = self._kst
+                self.__dict__["_kst"] = grown
+            self._kst[i] = self.version
+            unit = key >> 7 if key & 1 else key >> 13
+            if unit >= self._uw.shape[0]:
+                grown = np.zeros(max(self._cu, unit + 1), dtype=bool)
+                grown[:self._uw.shape[0]] = self._uw
+                self.__dict__["_uw"] = grown
+            self._uw[unit] = True
+        return i
+
+    def _changed(self, src: int, dst: int, form: int, lag: int) -> None:
+        """A tie was made or its evidence changed: the noted lists it is in are stamped."""
+        uw, n = self._uw, self._uw.shape[0]
+        if src < n and uw[src]:
+            i = self._kid.get(self.key_out(src, form, lag))
+            if i is not None:
+                self._kst[i] = self.version
+        if dst < n and uw[dst]:
+            i = self._kid.get(self.key_in(dst, form))
+            if i is not None:
+                self._kst[i] = self.version
+
+    def _changed_many(self, ties: np.ndarray) -> None:
+        v, uw = self._np(), self._uw
+        n = uw.shape[0]
+        src, dst = v.src[ties], v.dst[ties]
+        seen = np.zeros(ties.shape[0], dtype=bool)
+        inside = src < n
+        seen[inside] = uw[src[inside]]
+        inside = dst < n
+        seen[inside] |= uw[dst[inside]]
+        if seen.any():
+            form, lag = v.form[ties], v.lag[ties]
+            for a, b, f, l in zip(src[seen].tolist(), dst[seen].tolist(), form[seen].tolist(), lag[seen].tolist()):
+                self._changed(a, b, f, l)
+
+    def _drop_kept(self) -> None:
+        """A moment was undone or retracted: nothing kept holds."""
+        for name in ("_kept", "_kid", "_kst", "_uw", "_rev_begin"):
