+def _members_in_mind(mind, parts, where, category: int, exclude, ties, of_channel, channel):
+    """F73 (Exemplars Come to Mind, ``Config.member_window``): the members of a frame's place that a reading reads,
+    as F70 reads the frames of a family: T for every moment the context has been in mind (``aile.depth``). Only
+    members whose instance was lived count at all; of them, first those that stand most where the context's own filler
+    stands (F31's interchangeability, 1/2 where they never shared a place), then the surest members, then the one
+    lived first; read in the place's own order. A place with no more such members than that is read whole, as
+    before."""
+    from .aile import depth
+    S = mind.S
+    src = mv_view(mind, "t_src")
+    budget = int(mind.cfg.T) * (depth(mind, mind.context) if getattr(mind, "context", None) is not None else 1)
+    if len(ties) <= budget:
+        return ties
+    lived = []
+    for i, tie in enumerate(ties):
+        x = src[tie]
+        if of_channel is not None and of_channel[x] != channel:
+            continue
+        instance = S.tuple_index.get(tuple(x if j in where else p for j, p in enumerate(parts)))
+        if instance is not None and instance != exclude:
+            lived.append((i, tie, x))
+    if len(lived) <= budget:
+        return [tie for _, tie, _ in lived]
+    memo = _moment_memo(mind)
+    key = ("exemplars", category, tuple(parts), exclude, channel, budget)
+    hit = memo.get(key)
+    if hit is not None:
+        return hit
+    k = mind.cfg.k
+    kinds = mv_view(mind, "u_kind")
+    near = {}
+    if exclude is not None and kinds[exclude] & COMPOSED and where:
+        held = parts_of(mind, exclude)
+        if len(held) > where[0]:
+            near = stand_ins(mind, held[where[0]], getattr(mind, "episode_start", mind.t))
+
+    def order(entry):
+        i, tie, x = entry
+        alike = near.get(x)
+        return (-(expectation(alike[0], alike[1], k) if alike is not None else 0.5),
+                -expectation(*mass1(mind, tie), k), i)
+    chosen = sorted(sorted(lived, key=order)[:budget])
+    hit = memo[key] = [tie for _, tie, _ in chosen]
+    return hit
+
